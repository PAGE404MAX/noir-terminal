    def toggle_playback(self) -> None:
        if self.playing:
            self.stop_playback()
            return
        self.playing = True
        self._last_playback_time = time.perf_counter()
        self.update_transport()

    def toggle_loop(self) -> None:
        self.loop_enabled = not self.loop_enabled
        self.loop_btn.setChecked(self.loop_enabled)
        self.playlist_view.update()

    def stop_playback(self) -> None:
        self.playing = False
        self.playhead_song_beat = 0.0
        self._last_playback_time = time.perf_counter()
        self._release_all()
        self.update_transport()
        self.playlist_view.update()
        self.piano_roll.update()

    def _release_all(self) -> None:
        for key in list(self._last_active_keys):
            if key.startswith("s:"):
                self.synth.note_off(key)
        self._last_active_keys.clear()

    def update_transport(self) -> None:
        self.play_btn.blockSignals(True)
        self.play_btn.setChecked(self.playing)
        self.play_btn.setText("●" if self.playing else "○")
        self.play_btn.blockSignals(False)

    def _collect_active(self) -> Dict[str, tuple]:
        beat = self.playhead_song_beat
        active: Dict[str, tuple] = {}
        any_solo = any(getattr(t, "solo", False) for t in self.playlist_tracks)
        for t_idx, track in enumerate(self.playlist_tracks):
            ensure_track(track)
            if track.muted:
                continue
            if any_solo and not track.solo:
                continue
            for c_idx, clip in enumerate(track.clips):
                if clip.muted or not (clip.start_beat <= beat < clip.start_beat + clip.duration_beats):
                    continue
                pat = ensure_pattern(self.patterns[clip.pattern_index])
                local = (beat - clip.start_beat) % max(0.0001, pat.length_beats)
                if pattern_mode(pat) == "drums":
                    step_beats = grid_value(pat.step_duration)
                    step = max(0, min(pat.step_count - 1, int(local / step_beats)))
                    for row, row_data in enumerate(pat.drum_grid):
                        vel = int(row_data[step])
                        if vel > 0:
                            active[f"d:{t_idx}:{c_idx}:{row}:{step}"] = ("drum", clip.pattern_index, row, vel)
                else:
                    for n_idx, note in enumerate(pat.notes):
                        if not note.muted and note.start <= local < note.start + note.duration:
                            active[f"s:{t_idx}:{c_idx}:{n_idx}"] = ("synth", pat, note)
        return active

    def update_playback(self) -> None:
        now = time.perf_counter()
        if not self.playing:
            self._last_playback_time = now
            self.sync_drum_panel(runtime_only=True)
            return
        delta = now - self._last_playback_time
        self._last_playback_time = now
        self.playhead_song_beat += delta * (self.bpm / 60.0)
        if self.loop_enabled and self.loop_end > self.loop_start and self.playhead_song_beat >= self.loop_end:
            self.playhead_song_beat = self.loop_start + (self.playhead_song_beat - self.loop_end) % (self.loop_end - self.loop_start)
            self._release_all()

        active = self._collect_active()
        active_keys = set(active.keys())
        for key in self._last_active_keys - active_keys:
            if key.startswith("s:"):
                self.synth.note_off(key)
        for key in active_keys - self._last_active_keys:
            data = active[key]
            if data[0] == "drum":
                _, pat_idx, row, vel = data
                self.trigger_drum_sample(pat_idx, row, vel)
            else:
                _, pat, note = data
                self.synth.note_on(key, note.pitch, velocity=max(0.0, min(1.0, note.velocity / 127.0)), waveform=pat.waveform, gain=pat.gain)
        self._last_active_keys = active_keys
        self.playlist_view.update()
        self.piano_roll.update()
        self.sync_drum_panel(runtime_only=True)

    def preview_note_on(self, key: str, pitch: int) -> None:
        self._preview_keys.add(key)
        pat = self.current_pattern()
        self.synth.note_on(key, pitch, velocity=0.9, waveform=pat.waveform, gain=min(1.0, pat.gain))

    def preview_note_off(self, key: str) -> None:
        if key in self._preview_keys:
            self.synth.note_off(key)
            self._preview_keys.discard(key)

    def _cleanup_temp_sample_dirs(self) -> None:
        for folder in self._temp_sample_dirs:
            try:
                shutil.rmtree(folder, ignore_errors=True)
            except Exception:
                pass
        self._temp_sample_dirs.clear()

    def _extract_samples_from_zip(self, zip_path: str) -> List[str]:
        audio_exts = {".wav", ".mp3", ".ogg", ".flac"}
        with zipfile.ZipFile(zip_path, "r") as zf:
            audio_names = [
                name for name in zf.namelist()
                if not name.endswith("/") and Path(name).suffix.lower() in audio_exts
            ]
            audio_names.sort(key=lambda name: (Path(name).suffix.lower(), Path(name).name.lower()))
            if not audio_names:
                raise ValueError("No audio files found in ZIP file.")

            temp_dir = tempfile.mkdtemp(prefix="nill_drum_zip_")
            self._temp_sample_dirs.append(temp_dir)
            extracted: List[str] = []
            for idx, name in enumerate(audio_names[:16]):
                suffix = Path(name).suffix.lower()
                stem = Path(name).stem or f"sample_{idx+1}"
                safe_name = "".join(ch if ch.isalnum() or ch in ("_", "-") else "_" for ch in stem)
                target = Path(temp_dir) / f"{idx:02d}_{safe_name}{suffix}"
                with zf.open(name) as src, open(target, "wb") as dst:
                    shutil.copyfileobj(src, dst)
                extracted.append(str(target))
        return extracted

    def load_drum_samples(self) -> None:
        pat = self.current_pattern()
        if pattern_mode(pat) != "drums":
            return
        paths, _ = QFileDialog.getOpenFileNames(
            self,
            "Load Drum Samples or ZIP Kit",
            str(Path.home()),
            "Audio / Drum Pack (*.wav *.mp3 *.ogg *.flac *.zip);;ZIP Drum Pack (*.zip);;Audio Files (*.wav *.mp3 *.ogg *.flac)",
        )
        if not paths:
            return

        audio_exts = {".wav", ".mp3", ".ogg", ".flac"}
        resolved: List[str] = []
        zip_count = 0
        for source in paths:
            suffix = Path(source).suffix.lower()
            if suffix == ".zip":
                try:
                    extracted = self._extract_samples_from_zip(source)
                except Exception as exc:
                    QMessageBox.warning(self, "Load Drum ZIP", f"Failed to import ZIP:\n{source}\n\n{exc}")
                    continue
                resolved.extend(extracted)
                zip_count += 1
            elif suffix in audio_exts:
                resolved.append(source)
            if len(resolved) >= 16:
                break

        resolved = resolved[:16]
        if not resolved:
            QMessageBox.warning(self, "Load Drum Samples", "No valid drum samples were loaded.")
            return

        pat.drum_samples = resolved
        ensure_pattern(pat)
        self.ensure_pattern_sampler(self.selected_pattern_index, force=True)
        self.sync_ui()
        source_label = "ZIP kit" if zip_count == 1 and len(paths) == 1 and Path(paths[0]).suffix.lower() == ".zip" else "selection"
        self.set_status(f"Loaded {len(resolved)} drum samples from {source_label}")

