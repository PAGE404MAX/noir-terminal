        self.show_grid_check.setChecked(self.show_grid)
        self.show_grid_check.blockSignals(False)
        i = self.grid_combo.findText(self.current_grid_label)
        if i >= 0:
            self.grid_combo.blockSignals(True)
            self.grid_combo.setCurrentIndex(i)
            self.grid_combo.blockSignals(False)
        li = self.length_combo.findText(length_label(self.current_note_length))
        if li >= 0:
            self.length_combo.blockSignals(True)
            self.length_combo.setCurrentIndex(li)
