    def _build_default_patterns(self) -> None:
        defs = [
            ("Bass", PATTERN_COLORS[3], "saw", [(0, 48, 2), (2, 36, 2), (4, 43, 2), (6, 41, 2)], 8.0),
            ("Lead", PATTERN_COLORS[4], "square", [(0, 60, 1), (1, 62, 1), (2, 64, 1), (3, 67, 1)], 8.0),
            ("Chord", PATTERN_COLORS[5], "triangle", [(0, 60, 2), (2, 65, 2), (4, 67, 2), (6, 64, 2)], 8.0),
            ("Arp", PATTERN_COLORS[6], "triangle", [(0, 72, 0.5), (0.5, 76, 0.5), (1, 79, 0.5), (1.5, 84, 0.5)], 4.0),
        ]
        for name, color, wave, notes, length in defs:
            p = Pattern(name=name, color=color, waveform=wave, length_beats=length)
            p.mode = "synth"
            for start, pitch, dur in notes:
                p.notes.append(Note(pitch=pitch, start=start, duration=dur))
            self.patterns.append(ensure_pattern(p))
        drum = Pattern(name="Drums", color=PATTERN_COLORS[0], waveform="noise", length_beats=4.0)
        drum.mode = "drums"
        drum.step_count = 16
        drum.step_duration = "1/16"
        drum.swing = 0.0
        drum.drum_samples = []
        drum.drum_grid = [[0] * 16 for _ in range(8)]
        self.patterns.append(ensure_pattern(drum))

    def _build_default_tracks(self) -> None:
        for i in range(8):
            t = PlaylistTrack(name=f"Track {i+1}", color=PATTERN_COLORS[i % len(PATTERN_COLORS)])
            t.track_type = "drums" if i == 4 else "synth"
            self.playlist_tracks.append(ensure_track(t))
        for t_idx in range(4):
            pat = self.patterns[t_idx]
            for bar in range(2):
                self.playlist_tracks[t_idx].clips.append(PlaylistClip(pattern_index=t_idx, track_index=t_idx, start_beat=bar * pat.length_beats, duration_beats=pat.length_beats))

    def _start_audio(self) -> None:
        if sd is None:
            return
        try:
            self.stream = sd.OutputStream(samplerate=self.synth.sample_rate, channels=1, blocksize=self.synth.buffer_size, callback=self.audio_callback)
            self.stream.start()
        except Exception:
            self.stream = None

    def audio_callback(self, outdata, frames, time_info, status) -> None:
        synth_audio = self.synth.generate_audio(frames)
        drum_audio = np.zeros(frames, dtype=np.float32)
        for sampler in list(self.samplers.values()):
            drum_audio += sampler.generate_audio(frames)
        outdata[:, 0] = np.clip(synth_audio + drum_audio, -0.97, 0.97)

