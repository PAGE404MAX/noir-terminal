        self.length_label.setText(f"{length_label(self.current_note_length)} ({beats_to_ms(self.current_note_length, self.bpm):.0f}ms @ {self.bpm} BPM)")
        synth_mode = pattern_mode(pat) == "synth"
        self.length_combo.setVisible(synth_mode)
        self.length_label.setVisible(synth_mode)
        self.quantize_btn.setVisible(synth_mode)
        self.drum_side.setVisible(not synth_mode)
        self.sync_drum_panel()
