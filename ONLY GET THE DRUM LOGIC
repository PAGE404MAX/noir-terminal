        menu = QMenu(self)
        track = ensure_track(self.playlist_tracks[track_idx])
        menu.addAction("Mute" if not track.muted else "Unmute").triggered.connect(lambda: self.toggle_track_mute(track_idx))
        menu.addAction("Solo" if not track.solo else "Unsolo").triggered.connect(lambda: self.toggle_track_solo(track_idx))
        menu.addSeparator()
        menu.addAction("Convert to Synth Track").triggered.connect(lambda: self.set_track_type(track_idx, "synth"))
        menu.addAction("Convert to Drum Track").triggered.connect(lambda: self.set_track_type(track_idx, "drums"))
        menu.addSeparator()
        menu.addAction("Delete Track").triggered.connect(lambda: self.delete_track(track_idx))
