        ]
        for shortcut, slot in items:
            act = QAction(self)
            act.setShortcut(shortcut)
            act.setShortcutContext(Qt.ShortcutContext.ApplicationShortcut)
            act.triggered.connect(slot)
            self.addAction(act)

    def refresh_pattern_buttons(self) -> None:
        while self.pattern_button_layout.count():
            item = self.pattern_button_layout.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()
        self._pattern_buttons = []
        for i, pat in enumerate(self.patterns):
            btn = QPushButton(f"P{i+1}")
            btn.setCheckable(True)
            btn.setFixedWidth(42)
            btn.setToolTip(f"{pat.name} [{pattern_mode(pat)}]")
            btn.clicked.connect(lambda checked=False, idx=i: self.set_selected_pattern(idx))
            self._pattern_buttons.append(btn)
            self.pattern_button_layout.addWidget(btn)
        self.pattern_button_layout.addStretch(1)

    def current_pattern(self) -> Pattern:
        return ensure_pattern(self.patterns[self.selected_pattern_index])

    def current_track(self) -> Optional[PlaylistTrack]:
        if 0 <= self.selected_track_index < len(self.playlist_tracks):
            return ensure_track(self.playlist_tracks[self.selected_track_index])
        return None

    def set_selected_pattern(self, idx: int) -> None:
        self.selected_pattern_index = max(0, min(len(self.patterns) - 1, idx))
        for i, btn in enumerate(self._pattern_buttons):
            btn.blockSignals(True)
            btn.setChecked(i == self.selected_pattern_index)
            btn.blockSignals(False)
        self.sync_ui()

    def select_track(self, idx: int) -> None:
        self.selected_track_index = max(0, min(len(self.playlist_tracks) - 1, idx))
        track = self.current_track()
        if track and pattern_mode(self.current_pattern()) != track.track_type:
            clip_pattern = next((c.pattern_index for c in track.clips if 0 <= c.pattern_index < len(self.patterns) and pattern_mode(self.patterns[c.pattern_index]) == track.track_type), None)
            if clip_pattern is None:
                clip_pattern = next((i for i, p in enumerate(self.patterns) if pattern_mode(p) == track.track_type), None)
            if clip_pattern is None:
                clip_pattern = self.create_pattern(track.track_type)
            self.selected_pattern_index = clip_pattern
        self.sync_ui()

    def create_pattern(self, mode: str) -> int:
        color = PATTERN_COLORS[len(self.patterns) % len(PATTERN_COLORS)]
        if mode == "drums":
            p = Pattern(name=f"Drums {len(self.patterns)+1}", color=color, waveform="noise", length_beats=4.0)
            p.mode = "drums"
            p.step_count = 16
            p.step_duration = "1/16"
            p.swing = 0.0
            p.drum_samples = []
            p.drum_grid = [[0] * 16 for _ in range(8)]
        else:
            p = Pattern(name=f"Pattern {len(self.patterns)+1}", color=color, waveform="square", length_beats=8.0)
            p.mode = "synth"
        self.patterns.append(ensure_pattern(p))
        self.refresh_pattern_buttons()
        return len(self.patterns) - 1

    def add_track(self, track_type: str = "synth") -> None:
        idx = len(self.playlist_tracks)
        t = PlaylistTrack(name=f"Track {idx+1}", color=PATTERN_COLORS[idx % len(PATTERN_COLORS)])
        t.track_type = track_type
        self.playlist_tracks.append(ensure_track(t))
        self.playlist_view.updateGeometry()
        self.playlist_view.update()
        self.select_track(idx)

    def set_playlist_zoom(self, zoom: float) -> None:
        self.playlist_view.zoom_x = max(0.25, min(4.0, zoom))
        self.playlist_view.updateGeometry()
        self.playlist_view.update()

    def apply_piano_zoom(self) -> None:
        pat = self.current_pattern()
        if pattern_mode(pat) == "drums":
            w = int(PianoRoll.DRUM_LIST_W + pat.length_beats * 52 * self.piano_roll.zoom_x) + 80
            h = int(PianoRoll.HEADER_H + len(pat.drum_grid) * self.piano_roll.drum_row_h()) + 24
        else:
            w = int(PianoRoll.KEYBOARD_W + pat.length_beats * 52 * self.piano_roll.zoom_x) + 60
            h = int(PianoRoll.HEADER_H + (PianoRoll.MAX_MIDI - PianoRoll.MIN_MIDI + 1) * 14 * self.piano_roll.zoom_y) + 20
        self.piano_roll.setMinimumWidth(max(700, w))
        self.piano_roll.setMinimumHeight(max(320, h))
        self.piano_roll.updateGeometry()
        self.piano_roll.update()

    def sync_ui(self) -> None:
        pat = self.current_pattern()
        self.piano_roll.switch_mode(pattern_mode(pat))
        self.editor_title.setText(f"PIANO ROLL [{pattern_mode(pat).upper()}] - {pat.name}")
        self.snap_btn.setChecked(self.snap_enabled)
        self.ghost_btn.setChecked(self.show_ghost_notes)
