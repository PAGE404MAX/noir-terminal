    def sync_drum_panel(self, runtime_only: bool = False) -> None:
        pat = self.current_pattern()
        if pattern_mode(pat) != "drums":
            return
        self.current_step_label.setText(f"Current Step: {self.piano_roll.runtime_step() + 1 if self.piano_roll.runtime_step() >= 0 else '-'}")
        self.drum_bpm.blockSignals(True)
        self.drum_bpm.setValue(self.bpm)
        self.drum_bpm.blockSignals(False)
        if runtime_only:
            return
        self.step_count_combo.blockSignals(True)
        idx = self.step_count_combo.findData(pat.step_count)
        if idx >= 0:
            self.step_count_combo.setCurrentIndex(idx)
        self.step_count_combo.blockSignals(False)
        self.step_duration_combo.blockSignals(True)
        idx = self.step_duration_combo.findText(pat.step_duration)
        if idx >= 0:
            self.step_duration_combo.setCurrentIndex(idx)
        self.step_duration_combo.blockSignals(False)
        self.swing_spin.blockSignals(True)
        self.swing_spin.setValue(int(pat.swing * 100))
        self.swing_spin.blockSignals(False)

    def ensure_pattern_sampler(self, pattern_index: int, force: bool = False) -> Optional[Sampler]:
        if not (0 <= pattern_index < len(self.patterns)):
            return None
        pat = ensure_pattern(self.patterns[pattern_index])
        if pattern_mode(pat) != "drums":
            return None
        sampler = self.samplers.get(pattern_index)
        if sampler is None:
            sampler = Sampler(self.synth.sample_rate)
            self.samplers[pattern_index] = sampler
            force = True
        if force or sampler.source_paths != list(pat.drum_samples):
            sampler.set_samples(list(pat.drum_samples[:16]))
        return sampler

    def trigger_drum_sample(self, pattern_index: int, sample_index: int, velocity: int) -> None:
        sampler = self.ensure_pattern_sampler(pattern_index)
        if sampler:
            sampler.trigger(sample_index, max(0.0, min(1.0, velocity / 127.0)))

    def sync_clip_durations_for_pattern(self, pattern_index: int) -> None:
        if not (0 <= pattern_index < len(self.patterns)):
            return
        pat = self.patterns[pattern_index]
        for track in self.playlist_tracks:
            for clip in track.clips:
                if clip.pattern_index == pattern_index:
                    clip.duration_beats = pat.length_beats

